# Copia este archivo a .env.local si tu backend NO corre en localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Login con Google: el MISMO Client ID que GOOGLE_CLIENT_ID del backend.
# Como empieza con NEXT_PUBLIC_, queda dentro de la app compilada: después de
# cambiarlo hay que volver a correr `npm run build`. (No es secreto; Google lo
# da justamente para ponerlo en la página.)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
